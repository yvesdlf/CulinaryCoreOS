{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed:generate": "esbuild scripts/generate-seed.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/generate-seed.mjs --log-level=error && node node_modules/.cache/generate-seed.mjs",
    "test:visual": "playwright test visual.spec.ts",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:visual:update": "playwright test visual.spec.ts --update-snapshots",
    "test:keyboard": "playwright test keyboard.spec.ts",
    "test:sr": "playwright test screen-reader.spec.ts",
    "test:a11y:all": "playwright test accessibility.spec.ts keyboard.spec.ts screen-reader.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@ccos/shared": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.12.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
