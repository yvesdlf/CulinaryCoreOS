# CulinaryCoreOS web app — environment
#
# Copy to `.env.local` (git-ignored) and fill in.
# Without these the app runs against the in-memory mock catalogue instead.

# Local stack: run `supabase start` in the repo root and use the values it
# prints ("API URL" and "anon key"). Those local keys are well-known
# development defaults and are not secrets.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Hosted project: Project Settings -> API. Use the anon/publishable key only.
# The service_role key must never appear in client code or in this file.
